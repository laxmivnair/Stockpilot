# Copy to .env at the project root. Use different secrets outside local development.
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_DB=stockpilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql://stockpilot:replace-with-a-long-random-local-password@localhost:5432/stockpilot
DATABASE_SSL=false
PORT=4000

# The seed script creates this admin only when these values are supplied.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-long-unique-password
SEED_ADMIN_NAME=StockPilot Admin
